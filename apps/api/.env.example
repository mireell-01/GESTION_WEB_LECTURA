# Copiar a .env y completar. PostgreSQL 16 local (puerto 5432).
DATABASE_URL="postgresql://postgres:TU_CONTRASENA@localhost:5432/lectoaventura?schema=public"
JWT_SECRET="genera-uno-aleatorio-de-al-menos-32-caracteres"
PORT=3001
