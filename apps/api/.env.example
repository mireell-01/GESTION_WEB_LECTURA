# Correo: sin SMTP_HOST los correos se ven en http://localhost:3002/dev/correos
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Ingreso con Google para docentes y familias (docs/cambios/CR-02-ingreso-con-google.md).
# Sin estas dos variables, fuera de producción funciona el "Google de prueba"; en producción no se muestra el botón.
# URI de redireccionamiento a registrar en Google Cloud: <WEB_ORIGIN>/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
