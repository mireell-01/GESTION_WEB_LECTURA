{
  "name": "@lectoaventura/tests-load",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pruebas de rendimiento con k6 (k6 se instala como binario, no desde npm).",
  "scripts": {
    "test": "k6 run scenarios/iam-sesiones.js",
    "test:smoke": "k6 run -e DURACION=30s scenarios/iam-sesiones.js",
    "test:escuela": "k6 run scenarios/escuela-panel.js",
    "test:biblioteca": "node sembrar-biblioteca.mjs && k6 run scenarios/biblioteca.js",
    "test:aventura": "node sembrar-aventura.mjs && k6 run scenarios/aventura-mapa.js",
    "test:diagnostico": "k6 run scenarios/diagnostico-reto.js",
    "test:lectura": "k6 run -e LECTURA_ID=$(node sembrar-lectura.mjs) scenarios/lectura-respuestas.js",
    "test:seguimiento": "A=$(node sembrar-seguimiento.mjs) && k6 run -e AULA_ID=${A% *} -e EMAIL=${A#* } scenarios/seguimiento-panel.js",
    "test:familia": "k6 run -e EMAIL=$(node sembrar-familia.mjs) scenarios/familia-panel.js"
  }
}
